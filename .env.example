# Supabase — quote wizard lead capture.
# The publishable key ships in the browser bundle by design. It is safe because
# RLS grants anon INSERT only: it cannot read, update or delete rows.
# Reading submissions requires the service_role key, which must never be
# prefixed NEXT_PUBLIC_ or referenced from client code.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# Still to be supplied by the client. Until these land, the contact rows are
# omitted rather than shown as "pending", and the mobile bar links to /contact.
NEXT_PUBLIC_PHONE=
NEXT_PUBLIC_WHATSAPP=

# Resend — notification email on every quote submission.
# Server-side only: no NEXT_PUBLIC_ prefix, so the key never reaches the browser.
# Without these the lead is still saved; the route just logs that no mail was sent.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxx
QUOTE_NOTIFY_TO=leads@yourdomain.com
# Must be a domain verified in Resend. The onboarding@resend.dev fallback only
# delivers to the address that owns the Resend account.
QUOTE_NOTIFY_FROM=Quality Enterprises <quotes@yourdomain.com>
